FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Non-root user with UID/GID above 10000 so it never collides with a host user.
# Must match runAsUser/runAsGroup in k8s/deployment.yaml.
RUN groupadd --gid 10001 appuser \
 && useradd --uid 10001 --gid 10001 --no-create-home \
      --shell /usr/sbin/nologin appuser

COPY app/requirements.txt .
RUN pip install --no-cache-dir --disable-pip-version-check --root-user-action=ignore -r requirements.txt

COPY --chown=10001:10001 app/ .

USER 10001:10001

EXPOSE {{ port }}

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "{{ port }}"]
